{
  "name": "Second_CDMAMBA_baseline",
  "phase": "train",
  "gpu_ids": [0],
  "path": {
    "log": "logs",
    "tb_logger": "tb_logger",
    "results": "results",
    "checkpoint": "checkpoint",
    "resume_state": null
  },
  "datasets": {
    "train": {
      "name": "SECOND",
      "mode": "train",
      "dataroot": "path/to/SECOND/train",
      "l_resolution": 256,
      "r_resolution": 256,
      "batch_size": 8,
      "num_workers": 4,
      "use_shuffle": true,
      "data_len": -1
    },
    "val": {
      "name": "SECOND",
      "mode": "val", 
      "dataroot": "path/to/SECOND/val",
      "l_resolution": 256,
      "r_resolution": 256,
      "data_len": 50
    }
  },
  "model": {
    "name": "cdmamba_seg_cd",
    "loss": "extended_triplet",
    "extended_triplet": {
      "seg_loss": "weighted_ce_dice",
      "lambda_seg": 1.5,
      "lambda_cd": 1.0,
      "lambda_unch": 0.1,
      "lambda_ch": 0.2,
      "lambda_cpl": 0.1,
      "lambda_pseudo": 0.0,
      "boost": 5.0,
      "T": 4.0,
      "margin": 0.3,
      
      "_comment_baseline": "BASELINE CONFIG - All new features disabled",
      "seg_mask_mode": "full",
      "min_changed_threshold": 10,
      
      "_comment_unch_kl": "Unchanged KL without confidence gating",
      "use_conf_gate": false,
      "conf_tau": 0.9,
      "conf_method": "max_prob",
      "kl_warmup_epochs": 0,
      
      "_comment_pseudo": "Pseudo-labeling disabled",
      "use_pseudo_labeling": false,
      "pseudo_conf_tau": 0.9,
      
      "_comment_ablation": "All new features disabled for baseline",
      "enable_changed_only_supervision": false,
      "enable_unch_conf_gating": false,
      "enable_kl_warmup": false,
      "enable_pseudo_labeling": false
    },
    "use_change_head": true,
    "use_change_gating": false,
    "change_gate_alpha": 1.0,
    "change_gate_beta": 0.2,
    "change_gate_mode": "additive",
    "use_interaction_block": false,
    "interaction_num_heads": 4,
    "interaction_use_mamba": false,
    "init_filters": 16,
    "n_classes": 6,
    "conv_mode": "deepwise",
    "up_conv_mode": "deepwise",
    "spatial_dims": 2,
    "in_channels": 3,
    "in_nc": 3,
    "blocks_down": [1, 2, 2, 4],
    "blocks_up": [1, 1, 1],
    "norm": ["GROUP", {"num_groups": 8}]
  },
  "train": {
    "n_epochs": 100,
    "val_freq": 5,
    "save_checkpoint_freq": 10,
    "print_freq": 100,
    "optimizer": {
      "type": "adamw",
      "lr": 0.0001,
      "weight_decay": 0.01,
      "betas": [0.9, 0.999]
    },
    "scheduler": {
      "type": "CosineAnnealingLR",
      "T_max": 100,
      "eta_min": 1e-6
    },
    "use_balanced_sampler": false
  }
}
